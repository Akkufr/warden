{
  "manifest_version": 3,
  "name": "Warden — Social Media Likeness Shield",
  "version": "1.1.0",
  "description": "Consent-based biometric upload gating for Instagram DMs and WhatsApp Web. Intercepts attachments and prevents unauthorized AI likeness fraud.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Warden Likeness Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.whatsapp.com/*",
    "*://web.whatsapp.com/*",
    "*://whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "*://*.instagram.com/*",
        "*://instagram.com/*",
        "*://*.whatsapp.com/*",
        "*://web.whatsapp.com/*",
        "*://whatsapp.com/*",
        "http://127.0.0.1:8000/test_instagram_dm_mock.html*",
        "http://localhost:8000/test_instagram_dm_mock.html*",
        "http://127.0.0.1:8000/test_whatsapp_web_mock.html*",
        "http://localhost:8000/test_whatsapp_web_mock.html*",
        "http://127.0.0.1:8000/mock_instagram_registry.html*",
        "http://localhost:8000/mock_instagram_registry.html*",
        "http://127.0.0.1:8000/extension/test_instagram_dm_mock.html*",
        "http://localhost:8000/extension/test_instagram_dm_mock.html*",
        "http://127.0.0.1:8000/extension/test_whatsapp_web_mock.html*",
        "http://localhost:8000/extension/test_whatsapp_web_mock.html*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
